{
  "name": "@revolab/backend",
  "version": "0.1.0",
  "description": "Lógica interna de RevoLab (servicios, repositorios, Prisma) consumida por frontend/",
  "private": true,
  "type": "module",
  "exports": {
    "./config/*": "./src/config/*.js",
    "./services/*": "./src/services/*.js",
    "./repositories/*": "./src/repositories/*.js",
    "./validations/*": "./src/validations/*.js",
    "./auth/*": "./src/auth/*.js",
    "./integrations/*": "./src/integrations/*.js"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}

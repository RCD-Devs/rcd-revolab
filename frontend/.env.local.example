# Base de datos (misma DATABASE_URL que backend/.env — Next.js corre
# @revolab/backend en su propio proceso y necesita esta variable disponible)
DATABASE_URL="postgresql://usuario:password@host:6543/revolab?pgbouncer=true"

# Auth.js
AUTH_SECRET="genera un valor con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Storage (local | r2)
STORAGE_PROVIDER="local"
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL= (dominio publico del bucket, ej. https://pub-xxxx.r2.dev — requiere
#   "Public access: Allow Access" habilitado en Settings del bucket en Cloudflare)
